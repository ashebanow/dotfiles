# ~/.zshenv — bootstrap for the FIRST shell (ZDOTDIR not yet set in the
# environment). The real content lives at $ZDOTDIR/.zshenv: a nested shell
# spawned from a parent that already exported ZDOTDIR reads that file
# directly (zsh looks up .zshenv in $ZDOTDIR), so it never sees this one —
# hence this file only sets the two vars and hands off.
#
# Fresh shell: ZDOTDIR unset -> zsh reads this file -> sets ZDOTDIR ->
# sources $ZDOTDIR/.zshenv.
# Nested shell: ZDOTDIR inherited -> zsh reads $ZDOTDIR/.zshenv directly.

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR=$XDG_CONFIG_HOME/zsh

[ -f "$ZDOTDIR/.zshenv" ] && source "$ZDOTDIR/.zshenv"
