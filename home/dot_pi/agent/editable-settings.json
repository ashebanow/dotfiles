{
  "lastChangelogVersion": "0.85.1",
  "compaction": {
    "enabled": true,
    "reserveTokens": 64000,
    "keepRecentTokens": 15000
  },
  "contextShake": {
    "autoShake": true,
    "dropThinking": true,
    "dropRawToolOutput": [
      "linear"
    ]
  },
  "defaultProvider": "bifrost",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": false,
  "packages": [
    "https://github.com/ayghri/i-have-adhd",
    "npm:@alasano/pi-linear",
    "npm:@ashebanow/pi-gotgenes-subagent",
    "npm:@feniix/pi-exa",
    "npm:pi-background-tasks@latest",
    "npm:pi-context-shake",
    "npm:pi-context-view",
    "npm:pi-mcp-extension"
  ],
  "pi-exa": {
    "enabledTools": [
      "web_search_exa",
      "web_fetch_exa",
      "web_answer_exa"
    ]
  },
  "theme": "gruvbox-hard"
}
