{
  "lastChangelogVersion": "1.5.0",
  "compaction": {
    "enabled": true,
    "reserveTokens": 32000,
    "keepRecentTokens": 15000,
    "methodOrder": [
      "shake",
      "summarize"
    ]
  },
  "defaultProvider": "bifrost",
  "defaultModel": "deepseek-v4-flash",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "packages": [
    "git:https://github.com/joshleblanc/pi-minimax",
    "npm:@ashebanow/pi-gotgenes-subagent",
    "npm:@feniix/pi-exa",
    "npm:pi-background-tasks@latest",
    "npm:@amaster.ai/pi-image-gen"
  ],
  "pi-exa": {
    "enabledTools": [
      "web_search_exa",
      "web_fetch_exa",
      "web_answer_exa"
    ]
  },
  "theme": "gruvbox-hard",
  "pi-image-gen": {
    "defaultModel": "gemini/gemini-nano-banana-2.1",
    "outputDir": ".pi/images"
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:@ashebanow/pi-gotgenes-subagent\",\"scope\":\"user\"}": "18.2.0",
    "{\"source\":\"npm:@feniix/pi-exa\",\"scope\":\"user\"}": "7.1.1"
  }
}