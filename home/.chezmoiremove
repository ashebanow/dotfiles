# Files chezmoi should remove from the target (~) even though it no
# longer manages them, because chezmoi does not delete previously-managed
# files just because their source was removed.

# mise retired in favor of nix-managed packages (2026-08)
.config/mise/config.toml
.local/bin/setup-mise.sh

# lib/install/nix.sh (dead code, never active) removed; this was its
# only consumer (2026-08)
.local/share/nix/etc-nix-nix.conf

# nix.custom.conf retired — daemon-side nix config is now owned by the
# flake (nix.settings on NixOS, determinate module on nix-darwin), so
# the chezmoi-managed copy is stale legacy (2026-08)
.config/nix/nix.custom.conf

# BOX-170 pruning pass. Every entry below is gated on the SAME predicate as
# the exclusion that stops it being managed — .chezmoiremove is NOT itself
# machine-gated, so an ungated path here deletes the file everywhere.
# (Target paths, not source paths.)
{{ if not (and (hasKey . "desktop") .desktop) }}
.config/systemd/user/sunset.service
.config/systemd/user/sunset.timer
{{ end }}
{{ if .headless }}
.config/systemd/user/tmux.service
.config/containers/systemd/mealie.container
.config/zennotes/config.toml
.local/bin/mac_logout_handler.zsh
.local/bin/git-prompt-path
.local/bin/list-cloudflare-ips
.local/bin/nerdfont-smoke-test
.local/bin/setup-bws-keyring.sh
.config/.obsidian
.config/syncthingtray.ini
.config/YouTube Music
.config/Code
.zshenv
{{ end }}

# Claude Code gets the Matt Pocock skills from the mattpocock-skills plugin;
# the per-skill symlinks into ~/.agents/skills duplicated every one of them
# (2026-11). pi still reads the vendored copies in ~/.agents/skills directly.
{{- range list "ask-matt" "chief-of-staff" "claude-handoff" "code-review" "codebase-design" "diagnosing-bugs" "domain-modeling" "git-guardrails-claude-code" "grill-me" "grill-with-docs" "grilling" "handoff" "implement" "implement-spec" "improve-codebase-architecture" "loop-me" "migrate-to-shoehorn" "pr" "prototype" "research" "retro" "scaffold-exercises" "setup-matt-pocock-skills" "setup-pre-commit" "setup-ts-deep-modules" "tdd" "teach" "to-questionnaire" "to-spec" "to-tickets" "triage" "wait-what" "wayfinder" "wizard" "writing-beats" "writing-for-agents" "writing-fragments" "writing-shape" }}
.claude/skills/{{ . }}
{{- end }}
