# Files chezmoi should remove from the target (~) even though it no
# longer manages them, because chezmoi does not delete previously-managed
# files just because their source was removed.

# mise retired in favor of nix-managed packages (2026-08)
.config/mise/config.toml
.local/bin/setup-mise.sh

# lib/install/nix.sh (dead code, never active) removed; this was its
# only consumer (2026-08)
.local/share/nix/etc-nix-nix.conf

# nix.custom.conf retired — daemon-side nix config is now owned by the
# flake (nix.settings on NixOS, determinate module on nix-darwin), so
# the chezmoi-managed copy is stale legacy (2026-08)
.config/nix/nix.custom.conf
