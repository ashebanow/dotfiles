# Rex's ssh guard. Managed here rather than appended by `rex terminfo
# setup`, so chezmoi stays the single writer of this file. The target is
# written by rex; `rex terminfo status` reports the guard as already in
# effect. Missing file is fine: ssh ignores an Include that does not resolve,
# so this is a no-op until `rex terminfo setup` has run. It must not be group-
# or world-writable, though — ssh refuses such a file ("Bad owner or
# permissions") and drops the guard.
#
# FIRST in the file, deliberately: it is a Match block, which ssh only honours
# before the first Host block, and ssh keeps the earliest value for a setting,
# so this SetEnv TERM must precede "Host *" below.
Include "{{ .chezmoi.homeDir -}}/.config/rex/ssh_config"

# Managed by lazyssh

Host bergamot berg
    HostName bergamot

Host berg.*
    HostName bergamot
    RemoteCommand zmx attach %k
    RequestTTY yes

Host yuzu.*
    HostName yuzu
    RemoteCommand zmx attach %k
    RequestTTY yes

Host yuzu
    HostName yuzu

Host lum.*
    HostName lumquat
    User podman
    RemoteCommand zmx attach %k
    RequestTTY yes

Host lumquat lum
    HostName lumquat
    User podman

Host mm.*
    HostName miraclemax
    RemoteCommand zmx attach %k
    RequestTTY yes

Host miraclemax mm
    HostName miraclemax

Host limon li
    HostName limon

Host calamansi cala
    HostName calamansi

Host reverse-proxy
    User root

Host unifi
    User ubnt

Host storage
    User root

Host *.ts.net 100.*
    IdentitiesOnly no
    # Tailscale SSH authenticates via TS identity, not SSH keys.
    # Allow fallback to any available key/auth method.

Host github.com github
    HostName ssh.github.com
    Port 443
    User git
    IdentitiesOnly yes
    IdentityFile {{ .chezmoi.homeDir -}}/.ssh/github_ed25519.pub

Host *
    User ashebanow
    IdentitiesOnly yes
    IdentityFile {{ .chezmoi.homeDir -}}/.ssh/id_ed25519.pub
    ControlMaster auto
    ControlPath ~/.ssh/controlmaster/%r@%h:%p
    ControlPersist yes
