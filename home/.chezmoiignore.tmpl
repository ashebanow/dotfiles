{{ if .headless }}
# ── headless machines: no personal secrets/dev tools, minimal toolset ──
# (BOX-123, revised by BOX-169/170. The positive rule: a managed file is kept
# iff the tool it configures is installed on this host at ANY tier, devshell
# included. The check is nix-config's inventory, never a remembered list —
# see CONTEXT.md "installed-tool rule" and docs/adr/0001. This block is
# therefore the residue: files whose tool is absent at every tier here, plus
# secret machinery and personal tooling. Desktop-session trees are gated on
# `not .desktop` above, not here.)
#
# Deliberately NOT here, with reasons (do not "tidy" these in):
#   .config/ghostty       — ghostty.terminfo is tier 1 on lumquat (system-wide,
#                           for terminfo); only the config file is GUI.
#   .config/worktrunk     — tier 3 (nix develop) devshell tool; Q9b.
#   .config/{btop,nvim}   — tier 1/2, interactive TUIs. Interactive ≠ GUI.
#   .config/fastfetch     — tier 2, invoked from the login path.
# Terminal / app configs whose tool is not installed on this host
.config/ghostty
.config/hop
.config/kitty
.config/lazygit
.config/oh-my-posh
.config/rslsync
.config/syncthingtray.ini
.config/television
.config/tmux
.config/topgrade
.config/warp-terminal
.config/wezterm
.config/zed
.config/zathura
.config/atuin
.config/jj
.local/share/warp-terminal
# Trees no pattern mentioned before BOX-170 — same defect class as above:
# tool absent at every tier, and (for the GUI two) desktop-only anyway.
.config/.obsidian
.config/YouTube Music
.config/Code
# zsh is not on headless (login shell is bash) — exclude both the config tree
# and the top-level .zshenv entrypoint, which would otherwise source it.
.config/zsh
.zshenv
# Dead prompt machinery — nothing on headless initializes starship, and
# nothing sources the nix gate (it exists only to feed starship's prompt).
# NOTE: these two are *excluded*, not retired — they are live on the desktops.
# Do not delete them from the source tree.
.config/bashrc.d/starship-gate.sh
.config/shell/starship-nix-gate.sh
# Secret machinery: BWS/keyring plumbing, not tool config. A tool config that
# merely *references* a secret is guarded, not excluded (see ~/.pi).
.config/shell/secrets.sh
.config/bashrc.d/999_secrets.sh
# Personal (ashebanow's) secrets & identity — headless carries none
.claude
.gnupg
.hermes
.lazyssh
.ssh
# Personal/dev tooling
Development
.rumdl.toml
# Tool-absent targets (BOX-170; judged against the installed-tool rule)
.config/devenv
.config/zennotes
.local/bin/mac_logout_handler.zsh
# A starship prompt helper: starship is absent at all three tiers HERE (it is
# installed on the desktops, where this script is live — exclude, do NOT
# retire). Same argument as the two prompt-gate files above.
.local/bin/git-prompt-path
# macOS-only tree (would otherwise land on a linux headless host)
Library
{{ end }}
