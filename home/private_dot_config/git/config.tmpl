# ALIASES
# -----------
[alias]
    a = "add"
    co = "checkout"
    rb = "rebase --interactive origin/main"
    rba = "rebase --abort"
    rbc = "rebase --continue"
    rbm = "rebase --interactive origin/master"
    # use as ```git squash-all -m "a brand new start"```
    # taken from https://stackoverflow.com/a/23486788/164655
    squash-all = "!f(){ git reset $(git commit-tree \"HEAD^{tree}\" \"$@\");};f"
    # Mirror a vendor repo's tags into a namespace of their own, so a soft fork's
    # upstream tags cannot collide with your own release tags.
    # Use as ```git vendor-tags gotgenes``` -> populates refs/tags/gotgenes/*
    vendor-tags = "!f(){ [ -n \"$1\" ] || { echo \"usage: git vendor-tags <remote>\" >&2; return 1; }; git fetch --no-tags --prune \"$1\" \"+refs/tags/*:refs/tags/$1/*\";};f"

# Tool setttings
# --------------

[core]
{{- if not .headless }}
	pager = "hunk pager"
{{- end }}

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

# We like our diff/merge tools!
{{- if not .headless }}
[diff]
	tool=difftastic
[difftool]
	prompt = false
[difftool "hunk"]
	cmd = hunk difftool \"$LOCAL\" \"$REMOTE\" \"$MERGED\"
[difftool "difftastic"]
    # See `man git-difftool` for a description of MERGED, LOCAL and REMOTE.
    cmd = difft "$MERGED" "$LOCAL" "abcdef1" "100644" "$REMOTE" "abcdef2" "100644"

[merge]
	tool=mergiraf
[mergetool]
	prompt = false
[merge "mergiraf"]
    name = mergiraf
    driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L

[pager]
    # Use a pager if the difftool output is larger than one screenful,
    # consistent with the behaviour of `git diff`.
    difftool = true
{{- end }}

{{ if eq .chezmoi.os "darwin" }}
[difftool "Kaleidoscope"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"
[difftool]
	prompt = false
	trustExitCode = true
[mergetool "Kaleidoscope"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true
{{ end }}

[init]
	defaultBranch = "main"

[branch]
	autosetupmerge = true

[pull]
	rebase = true

[push]
    default = "simple"
    recurseSubmodules = on-demand

[rerere]
	enabled = true

[submodule]
    recurse = true

[user]
	email = {{ .email | quote }}
	name = {{ .gitName | quote }}
{{- if not .headless }}
	signingkey = "{{ index (output "bws" "secret" "get" "b84feb92-7f56-471d-b1a8-b479014b3475" | fromJson) "value" | trim }}"
{{- end }}

{{- if not .headless }}
[gpg]
	format = "ssh"

[gpg "ssh"]
	allowedSignersFile = "~/.ssh/allowed_signers"

[commit]
	gpgsign = true
{{- end }}

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
