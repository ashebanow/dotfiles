# Template for providers.yaml
#
# You can add any OpenAI API compatible provider to the "providers" list.
# For each provider you must also specify a list of models, along with model abilities.
#
# All fields are required unless marked as optional.
#
# Refer to your provider's API documentation for specific
# details such as model identifiers, capabilities etc
#
# Note: Since the OpenAI API is not a standard we can't guarantee that all
# providers will work correctly with Raycast AI.
#
# To use this template rename as `providers.yaml`
#
providers:
  # The bifrost gateway. Model ids are bare: this entry is already the provider
  # namespace. Every model listed here must be one the gateway actually serves --
  # compose/llm/bifrost-config.json is the source of truth for the catalogue, and
  # this list is a deliberate subset, not the whole catalogue.
  - id: bifrost
    name: Bifrost
    base_url: https://ai.fluffy-walleye.ts.net/v1
    # Per-client attribution (BOX-200, parent BOX-149). The gateway records this
    # virtual key as `virtual_key_name` on every log row, so Raycast's traffic
    # is filterable by client instead of anonymous. `api_keys` is a map of alias
    # -> key; the alias is arbitrary and the first one is the default.
    #
    # Rendered by chezmoi via `bitwardenSecrets` at apply time, which is the only
    # mechanism available: Raycast is a hotkey-launched GUI app, so `secretspec
    # run` cannot reach it, and providers.yaml was converted from a plain tracked
    # file to a .tmpl for exactly this. The value comes from the same BWS item the
    # gateway reads, so the two sides cannot drift. Nothing in git holds it.
    #
    # Rides `Authorization: Bearer` (OpenAI-compatible convention). Like Zed,
    # Raycast is on the header BOX-193 must revisit: a virtual key is accepted
    # there only while auth-on-inference is false. `x-bf-vk` is not expressible
    # here -- `include_user_email` is the only header knob, and `additional_
    # parameters` are request-body fields, not headers.
    api_keys:
      bifrost: {{ (bitwardenSecrets "86a032e3-d3c3-4e26-a38e-b4c7013065ef").value }}
    # Sends X-User-Email with each request, landing in the log's User field
    # (user_id/user_name) -- a different column from virtual_key_name, so this is
    # a complementary per-human signal, not a duplicate of the key. Kept (D8).
    include_user_email: true
    models:
      - id: deepseek-v4-flash
        name: "DeepSeek V4 Flash"
        context: 1000000
        abilities:
          temperature:
            supported: true
          vision:
            supported: false
          system_message:
            supported: true
          tools:
            supported: true
      - id: deepseek-v4-pro
        name: "DeepSeek V4 Pro"
        context: 1000000
        abilities:
          temperature:
            supported: true
          vision:
            supported: false
          system_message:
            supported: true
          tools:
            supported: true
      - id: qwen-latest
        name: "Qwen (local)"
        context: 262144
        abilities:
          temperature:
            supported: true
          vision:
            supported: false
          system_message:
            supported: true
          tools:
            supported: true
