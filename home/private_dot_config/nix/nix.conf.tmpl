# User-level (client-side) nix config. Daemon-level settings like
# trusted-users / substituters / experimental-features are managed
# declaratively by the flake (nix.settings in modules/infra/nix/ on
# NixOS, determinate module on nix-darwin) — don't duplicate them here.
# This file also carries the GitHub access token (from bws) for
# private flake inputs.

accept-flake-config = true
auto-optimise-store = true
cores = 8
max-jobs = auto
access-tokens = github.com={{ index (output "bws" "secret" "get" "5a333d5a-d7aa-46cb-98e1-b479014cd326" | fromJson) "value" | trim }}

extra-experimental-features = nix-command flakes
