# -----------------------------------------------------
# .zshrc — Main zsh configuration
# Shared chunk layer (shell/core.sh + version-control.sh + productivity.sh +
# utility.sh + devtools.sh + shortcuts.sh, then hooks.sh) + zshrc.d/
# per-topic zsh-only configs. Sourced only on personal machines: headless
# hosts are bash-only (.chezmoiignore excludes .config/zsh).
# -----------------------------------------------------

# Ensure path arrays are unique
typeset -U path cdpath fpath manpath

export _SHELL_NAME=zsh

# Portable aliases/functions (shared with bash, every machine class)
source ~/.config/shell/core.sh

# Personal dev tools (brew/nvm/cargo/bling/tmux plugin manager)
source ~/.config/shell/devtools.sh

# Personal cd shortcuts
source ~/.config/shell/shortcuts.sh

# Version-control aliases (jj/just)
source ~/.config/shell/version-control.sh

# Shell productivity tools (bat/eza/duf/fzf)
source ~/.config/shell/productivity.sh

# Utility functions (extract/dircolors/zmx/tailscale)
source ~/.config/shell/utility.sh

# Per-topic zsh-only configs (zinit, completions, history, eza -g, zmx)
for config_file ($ZDOTDIR/zshrc.d/*.zsh(N)); do
  source $config_file
done

# Tool init (after zshrc.d: compinit in 01-completions must precede
# the compdef-driving evals)
source ~/.config/shell/hooks.sh

# Compile .zshrc for faster startup
if [[ ! -f ~/.zshrc.zwc || ~/.zshrc -nt ~/.zshrc.zwc ]]; then
  zcompile ~/.zshrc
fi
