#echo "Evaluating ~/.zshenv"
#set -x

#############################################################################
# zsh bootstrap (must run before anything reads ZDOTDIR)

# XDG_CONFIG_HOME is re-set idempotently in env.sh (bash needs it there).
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export ZDOTDIR=$XDG_CONFIG_HOME/zsh

#############################################################################
# Path management helpers (add_to_path & friends)
# Sourced before paths.sh so zsh keeps the replay-recording version of
# add_to_path (see replay_path_adds in paths.zsh).

[ -f "$ZDOTDIR/paths.zsh" ] && source "$ZDOTDIR/paths.zsh"  # headless: .config/zsh is ignored

#############################################################################
# Shared environment — exports only. bash sources this too via .bashrc.

source "$HOME/.config/shell/env.sh"

# Shared PATH machinery — add_to_path (no-op: paths.zsh defined it), nix
# init, shared user bins. bash sources this too via .bashrc.

source "$HOME/.config/shell/paths.sh"

#############################################################################
# Set after nix init (in paths.sh) so we pick up nix's zsh (nix wins),
# not Apple's. zsh-intent: NOT in env.sh (bash must keep SHELL=bash).

export SHELL=$(which zsh)

#############################################################################
# SSH agent socket (BOX-298)

# gcr-ssh-agent's socket. Desktop sessions export it themselves; shells whose
# parent is not the desktop session do not — Rex terminals under
# XDG_RUNTIME_DIR=/run/rex inherit nothing, and the failure is silent until git
# tries to sign: ssh-keygen -Y sign cannot reach an agent, so the commit aborts
# with "Couldn't get agent socket?" before git writes the object.
#
# Only fills an EMPTY value: a session that already points at an agent (1Password,
# a forwarded socket, a custom ssh-agent) keeps it. The -S test makes this a
# no-op on macOS and on headless hosts, which have no gcr.
if [[ -z "${SSH_AUTH_SOCK:-}" && -S "/run/user/$UID/gcr/.ssh" ]]; then
  export SSH_AUTH_SOCK="/run/user/$UID/gcr/.ssh"
fi

#############################################################################
# Secrets (BWS) — shared with bash via ~/.config/bashrc.d/999_secrets.sh

source "$HOME/.config/shell/secrets.sh"
