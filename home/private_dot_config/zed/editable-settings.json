  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "git_panel": {
    "dock": "right"
  },
  "auto_install_extensions": {
    "dockerfile": true,
    "docker-compose": true,
    "gem": true,
    "golangci-lint": true,
    "html": true,
    "java": true,
    "jinja2": true,
    "kdl": true,
    "lua": true,
    "make": true,
    "mcp-server-github": true,
    "nix": true,
    "proto": true,
    "ruby": true,
    "rust": true,
    "sql": true,
    "svelte": true,
    "toml": true
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "relative_line_numbers": "enabled",
  // Vim settings
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "gutters": {
    "min_line_number_digits": 3
  },
  "languages": {
    "Swift": {
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true,
      "language_servers": [
        "sourcekit-lsp"
      ]
    },
    "Python": {
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true,
      "language_servers": [
        "basedpyright"
      ]
    },
    "Markdown": {
      "format_on_save": "on",
      "remove_trailing_whitespace_on_save": true
    }
  },
  "context_servers": {
    "linear": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.linear.app/mcp"],
      "env": {},
      "settings": {}
    }
  },
  "load_direnv": "shell_hook",
  "base_keymap": "VSCode",
  "vim_mode": true,
  "ui_font_size": 15,
  "buffer_font_family": "CommitMono Nerd Font",
  // Set the buffer text's font fallbacks, this will be merged with
  // the platform's default fallbacks.
  "buffer_font_fallbacks": ["Symbols Nerd Font"],
  "buffer_font_size": 16.0,
  "terminal": {
    "font_family": "SauceCodePro Nerd Font",
    "font_fallbacks": ["Symbols Nerd Font"],
    "font_size": 16
  },
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light Hard",
    "dark": "Gruvbox Crisp Anysphere Blend Dark"
  },
  "agent": {
    // Version of this setting.
    "favorite_models": [
      {
        "provider": "Bifrost",
        "model": "deepseek-v4-flash",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "Bifrost",
        "model": "deepseek-v4-pro",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "Bifrost",
        "model": "qwen-latest",
        "enable_thinking": false
      },
      {
        "provider": "Bifrost",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      },
      // Kept on Zed's own cloud rather than the gateway: the gateway serves no
      // Gemini, so this is the only family where zed.dev is not duplicating a
      // path the gateway already covers. BOX-151 moves it onto the gateway.
      {
        "provider": "zed.dev",
        "model": "gemini-3.5-flash",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "default_profile": "ask",
    "default_model": {
      "effort": "medium",
      "enable_thinking": true,
      "provider": "Bifrost",
      "model": "deepseek-v4-flash"
    },
    // Whether the agent is enabled.
    "enabled": true,
    /// What completion mode to start new threads in, if available. Can be 'normal' or 'max'.
    "preferred_completion_mode": "normal",
    // Whether to show the agent panel button in the status bar.
    "button": true,
    // Where to dock the agent panel. Can be 'left', 'right' or 'bottom'.
    "dock": "left",
    // Default width when the agent panel is docked to the left or right.
    "default_width": 640,
    // Default height when the agent panel is docked to the bottom.
    "default_height": 320,
    // When enabled, the agent will stream edits.
    "stream_edits": false,
    // When enabled, agent edits will be displayed in single-file editors for review
    "single_file_review": false,
    "enable_feedback": true,
    "notify_when_agent_waiting": "primary_screen"
  },
  "lsp": {
    "rust-analyzer": {
      "binary": {
        "path_lookup": true
      }
    },
    "nix": {
      "binary": {
        "path_lookup": true
      }
    },
    "sourcekit-lsp": {
      "binary": {
        "path_lookup": true
      }
    }
  }
}
