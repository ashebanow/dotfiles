// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "preview_tabs": {
    "enable_preview_from_project_panel": true
  },
  "proxy": "",
  "agent_servers": {
    "pi-acp": {
      "type": "registry"
    }
  },
  "ssh_connections": [
    {
      "host": "lumquat",
      "username": "podman",
      "args": [],
      "projects": [
        {
          "paths": ["/home/podman/nix-config"]
        }
      ]
    }
  ],
  "language_models": {
    "openai_compatible": {
      // The bifrost gateway. Model ids are bare here: this entry is already the
      // provider namespace, so a prefixed id would nest namespace inside
      // namespace. The catalogue must stay a subset of what the gateway
      // actually declares -- compose/llm/bifrost-config.json is the authority.
      "Bifrost": {
        "api_url": "https://ai.fluffy-walleye.ts.net/v1",
        // No `api_key` here: OpenAiCompatibleSettingsContent accepts only
        // api_url, available_models and custom_headers. An unknown field made
        // the whole provider block fail to load. Zed takes OpenAI-compatible
        // credentials from the keychain or from <PROVIDER_ID>_API_KEY
        // (BIFROST_API_KEY) instead -- and the gateway enforces no key anyway.
        "available_models": [
          {
            "name": "qwen-latest",
            "display_name": "Qwen (local)",
            "max_tokens": 262144,
            "max_output_tokens": 32768,
            "max_completion_tokens": 262144,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          },
          {
            "name": "deepseek-v4-flash",
            "display_name": "DeepSeek V4 Flash",
            "reasoning_effort": "medium",
            "max_tokens": 1000000,
            "max_output_tokens": 393216,
            "max_completion_tokens": 1000000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          },
          {
            "name": "deepseek-v4-pro",
            "display_name": "DeepSeek V4 Pro",
            "reasoning_effort": "high",
            "max_tokens": 1000000,
            "max_output_tokens": 393216,
            "max_completion_tokens": 1000000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          },
          {
            "name": "claude-sonnet-5",
            "display_name": "Claude Sonnet 5",
            "reasoning_effort": "high",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 1000000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          },
          {
            "name": "claude-opus-5",
            "display_name": "Claude Opus 5",
            "reasoning_effort": "high",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 1000000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false
            }
          },
          {
            "name": "claude-haiku-4-5-20251001",
            "display_name": "Claude Haiku 4.5",
            "reasoning_effort": "medium",
            "max_tokens": 200000,
            "max_output_tokens": 64000,
            "max_completion_tokens": 200000,
            "capabilities": {
