# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
  . /etc/bashrc
fi

export _SHELL_NAME=bash

# Shared environment: exports, brew/nix init, PATH adds (Phase 2)
. "$HOME/.config/shell/env.sh"

# Portable aliases/functions (shared with zsh) (Phase 3)
. "$HOME/.config/shell/rc.sh"

# Per-shell extras
if [ -d ~/.bashrc.d ]; then
  for rc in ~/.bashrc.d/*; do
    if [ -f "$rc" ]; then
      . "$rc"
    fi
  done
fi
unset rc

# Tool init, keyed on $_SHELL_NAME (Phase 3)
. "$HOME/.config/shell/hooks.sh"
