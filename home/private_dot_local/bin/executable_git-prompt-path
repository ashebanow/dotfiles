#!/usr/bin/env bash

# Ensure common binary paths are available in non-interactive Starship shells
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if top_level=$(git rev-parse --show-toplevel 2>/dev/null); then
  repo_name=$(basename "$top_level")
  if [[ "$repo_name" =~ ^(main|master|dev|src)$ ]]; then
    parent_name=$(basename "$(dirname "$top_level")")
    echo "$parent_name/$repo_name"
  else
    echo "$repo_name"
  fi
else
  # Normal (non-repo) directory: show at most the last two segments,
  # abbreviating $HOME as ~ (zsh %2~ style). /Users/ashebanow/Documents/
  # Synced Files renders as Documents/Synced Files; ~/x stays ~/x.
  #
  # Build the display path with [[ ]] compares, NOT ${PWD/#$HOME/~}:
  # bash tilde-expands the replacement string there when running
  # non-interactively (shebang / bash -c, i.e. the starship spawn),
  # turning ~ back into $HOME and silently leaving the path unchanged.
  if [[ "$PWD" == "$HOME" ]]; then
    p="~"
  elif [[ "$PWD" == "$HOME/"* ]]; then
    p="~${PWD#"$HOME"}"
  else
    p="$PWD"
  fi
  # Drop one leading / so absolute paths count segments correctly;
  # only truncate when there are >= 3 (q has >= 2 slashes).
  q="${p#/}"
  if [[ "$q" != */*/* ]]; then
    echo "$p"
  else
    last="${q##*/}"
    second="${q%/*}"; second="${second##*/}"
    echo "$second/$last"
  fi
fi
