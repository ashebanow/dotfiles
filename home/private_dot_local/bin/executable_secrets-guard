#!/usr/bin/env bash
# secrets-guard — refuse to commit a secret into the dotfiles repo.
#
# The dotfiles tree is *managed*, not secret-free: it tracks placeholders like
# home/dot_pi/agent/private_auth.json, which must exist so chezmoi creates a
# correctly-permissioned (0600) empty file at ~/.pi/agent/auth.json on a fresh
# machine. The `private_` prefix is a chezmoi *permissions* signal only — it does
# nothing to keep content out of git, and .gitignore does not cover that path.
#
# That placeholder is normally `{}`, and pi writes real credentials into the
# *live* auth.json when a provider is logged in via `/login`. A `chezmoi add`
# or a broad `git add` at the wrong moment would copy a live key into a tracked
# file. Real secrets belong in BWS, resolved at launch by `secretspec run`
# (see home/private_dot_config/shell/attribution.sh) and never written to disk.
#
# So: check the index. Scanning staged *content* (not paths) catches the
# accident at the moment it would be committed, including renames and edits.
#
# Usage:  secrets-guard            # check the staged index
#         secrets-guard --all      # check every tracked file (CI / audit)
#
# Exit 0 clean, 1 on any finding. Wired as `just secrets-guard` and available as
# a git pre-commit hook if core.hooksPath is ever pointed here.

set -euo pipefail

# Files that legitimately hold a placeholder we expect to stay empty.
# Compared against the staged blob with whitespace stripped.
declare -A must_be_empty=(
  [home/dot_pi/agent/private_auth.json]='{}'
)

# Secret-shaped content. Deliberately conservative: a false positive is a
# one-line allowlist entry, a false negative is a leaked key. Patterns target
# the *shape* of vendor credentials, not the word "secret" (which appears
# throughout this repo's comments and docs).
patterns=(
  'sk-[A-Za-z0-9_-]{20,}'           # OpenAI/Anthropic/DeepSeek-style
  'sk-bf-[A-Za-z0-9]{16,}'          # bifrost virtual keys
  'ghp_[A-Za-z0-9]{20,}'            # GitHub PAT
  'github_pat_[A-Za-z0-9_]{20,}'    # GitHub fine-grained PAT
  'gho_[A-Za-z0-9]{20,}'            # GitHub OAuth
  'xox[baprs]-[A-Za-z0-9-]{10,}'    # Slack
  'AKIA[0-9A-Z]{16}'                # AWS access key id
  'AIza[0-9A-Za-z_-]{35}'           # Google API key
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'  # PEM private key
)

# --all audits the working tree of every tracked file (CI / periodic audit).
# Default is the index: the content that is about to become a commit.
if [[ "${1:-}" == "--all" ]]; then
  scan_cmd=(git grep -nEI)
  label="all tracked files"
else
  scan_cmd=(git grep --cached -nEI)
  label="staged changes"
fi

failed=0

# 1. The placeholder invariants: a file that must stay empty.
for path in "${!must_be_empty[@]}"; do
  # `--all` reads the working tree, the default reads the index blob.
  if [[ "${1:-}" == "--all" ]]; then
    content="$(cat "$path" 2>/dev/null || true)"
  else
    content="$(git show ":$path" 2>/dev/null || true)"
  fi
  if [[ -n "$content" ]]; then
    stripped="$(printf '%s' "$content" | tr -d '[:space:]')"
    if [[ "$stripped" != "${must_be_empty[$path]}" ]]; then
      printf '\n%s\n' "FAIL: $path is not an empty placeholder ${must_be_empty[$path]}"
      printf '%s\n' "      Found: $stripped"
      printf '%s\n' "      pi wrote a credential into it. Move the value to BWS and"
      printf '%s\n' "      restore the placeholder: printf '{}' > $path"
      failed=1
    fi
  fi
done

# 2. Secret-shaped content anywhere in the scanned set.
for pat in "${patterns[@]}"; do
  # -m1 per file would hide repeats; take all lines, which are few in practice.
  while IFS= read -r hit; do
    [[ -n "$hit" ]] || continue
    printf '\n%s\n' "FAIL: secret-shaped content in the index:"
    printf '      %s\n' "$hit"
    printf '%s\n' "      pattern: $pat"
    failed=1
  done < <("${scan_cmd[@]}" -e "$pat" -- . 2>/dev/null || true)
done

if (( failed )); then
  cat >&2 <<'MSG'

Refusing to leave a secret in the index.

A real credential belongs in BWS, not in this repo. The working pattern is
`secretspec run` at launch (see home/private_dot_config/shell/attribution.sh),
which resolves the value into the child process environment and never writes
it to disk.

If the hit is a genuine false positive (a documented example, a hash that
merely looks keyed), add the path to the allowlist in this script with a
comment saying why.

To inspect what is staged:  git diff --cached
To unstage a file:          git restore --staged <path>
MSG
  exit 1
fi

printf 'secrets-guard: clean (%s)\n' "$label"
