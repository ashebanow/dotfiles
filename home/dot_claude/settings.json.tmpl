{
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "enableWeakerNetworkIsolation": true,
    "network": {
        "allowedDomains": [
          "github.com",
          "*.github.com",
          "*.githubusercontent.com",
          "vault.bitwarden.com",
          "*.vault.bitwarden.com"
        ],
        "allowUnixSockets": [ ]
      }
  },
  "mcpServers": {
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.app/mcp"
    }
  },
  "permissions": {
    "deny": [
      "Read(.env*)",
      "Read(secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "skillOverrides": {
    "dg": "off"
  },
